# Copy this file to .env.local for local development.
# Never commit real keys — .env.local is git-ignored.

# Supabase project credentials (Project Settings → API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Which business_profile this deployment serves.
# In V1 (single tenant) this is fixed per deployment/env.
# Leave blank to let the app fall back to the first profile it finds.
VITE_BUSINESS_PROFILE_ID=

# --- Server-side only (used by /api serverless functions, never exposed to the browser) ---

# Supabase service role key — bypasses RLS, needed so the webhook can write
# call logs before a caller has authenticated. Server-side only.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# LLM provider key used to classify + draft responses to inbound calls/texts.
# Free tier, no card required: console.groq.com/keys
GROQ_API_KEY=your-groq-api-key

# Shared secret to verify webhook requests from your telephony/SMS provider
# before processing them. For Twilio, append it as a query param on the
# webhook URL: https://<your-domain>/api/webhook/incoming?secret=<this value>
TELEPHONY_WEBHOOK_SECRET=change-me
